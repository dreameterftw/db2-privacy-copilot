# Db2 connection settings
DB2_HOST=localhost
DB2_PORT=50000
DB2_DB=clinic
DB2_USER=db2inst1
DB2_PASSWORD=replace-with-a-strong-password

# Application schema
DB2_SCHEMA=DB2INST1

# Mock mode — set to 1 to run without a real Db2 instance (demo/dev only)
# Set to 0 (or remove) when Docker + Db2 are running
DB_MOCK=0

# LLM configuration (optional, for future use)
LLM_PROVIDER=local
LLM_MODEL=gpt-3.5-turbo

# API settings
API_SECRET_KEY=change-this-to-a-random-secret-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Classification thresholds
PII_VALUE_THRESHOLD=0.30
PII_NAME_THRESHOLD=0.35

# Request deadlines (days)
DEFAULT_REQUEST_DEADLINE_DAYS=30
